# Backend configuration.
# Fill these values only in a local .env or server environment.

NODE_ENV=development
PORT=3000
# One or more allowed frontend origins. Use comma-separated values when needed.
# Production: https://bacalarlegends-ar.com,https://www.bacalarlegends-ar.com,https://admin.bacalarlegends-ar.com
FRONTEND_ORIGIN=http://localhost:5173
# Production alias for Render deployments. Example only; set the real value in Render.
FRONTEND_URL=
# Legacy fallback alias, kept for compatibility.
CLIENT_URL=

# Private Supabase Admin configuration. Do not commit real keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI page proposal provider. Keep API keys server-side only.
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
