# Backend configuration.
# Fill these values only in a local .env or server environment.

NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Private Supabase Admin configuration. Do not commit real keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI page proposal provider. Keep API keys server-side only.
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
