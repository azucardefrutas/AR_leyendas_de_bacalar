# Copia este archivo a .env.local y pon los valores reales (los MISMOS que el
# frontend web: leyendas-de-bacalar/frontend/.env). La anon key es una clave de
# cliente pública; la seguridad la da RLS en Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
