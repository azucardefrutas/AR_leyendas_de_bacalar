# Frontend configuration for Vite.
# Values exposed to the browser must start with VITE_.

VITE_APP_NAME=Leyendas de Bacalar
VITE_API_URL=http://localhost:3000
# Backend API base URL. Local dev: http://localhost:3101
# Production: set to your deployed Render backend URL (e.g. https://<your-app>.onrender.com)
VITE_BACKEND_URL=http://localhost:3101
VITE_SITE_URL=http://localhost:5173
# Dedicated recovery entry for the admin console. It serves this same Vercel app.
VITE_ADMIN_URL=https://admin.bacalarlegends-ar.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=legend-assets
VITE_SUPABASE_DOCUMENT_BUCKET=legend-documents

# URL de descarga del APK de la app movil (pagina /descargar). Puede ser cualquier
# host: Supabase Storage publico, un release de GitHub, o /app/leyendas.apk si lo pones
# en frontend/public/app/. Vacio => la pagina muestra "proximamente".
VITE_APK_URL=
VITE_APK_VERSION=
